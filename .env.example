# ==============================================================================
# AI-FLOW: Environment Configuration Template
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# PostgreSQL Direct Connection (with pgvector support)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_flow"

# AI / LLM Configuration
# Supports Google Gemini API, OpenAI, or Anthropic
AI_PROVIDER="gemini" # "gemini" | "openai" | "anthropic" | "mock"
AI_API_KEY="your-ai-api-key"
AI_MODEL_NAME="gemini-1.5-flash" # or "gemini-1.5-pro", "gpt-4o", etc.
EMBEDDING_API_KEY="your-embedding-api-key"
EMBEDDING_MODEL_NAME="text-embedding-004"

# Document OCR & Processing
OCR_PROVIDER="tesseract" # "tesseract" | "vision" | "mock"
GOOGLE_VISION_API_KEY=""

# Redis Queue & Background Workers
REDIS_URL="redis://localhost:6379"

# Outbound Integrations
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@ai-flow.internal"

# Security & Encryption
ENCRYPTION_SECRET="super-secret-key-min-32-chars-long"
JWT_SECRET="super-jwt-secret-key-ai-flow"

# Demo Mode
NEXT_PUBLIC_DEMO_MODE="true"
